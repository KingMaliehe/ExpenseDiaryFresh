# Copy to .env and fill in.

# Postgres connection. For local dev with Docker:
#   docker run -d --name expensediary-pg -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=expensediary postgres:16
# Then DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expensediary
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expensediary

# JWT signing secrets. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string

# Access tokens live 15min, refresh tokens 30 days.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Email (Resend) — get a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=Expense Diary <onboarding@resend.dev>

# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed origins. * for any (dev only).
CORS_ORIGIN=*
