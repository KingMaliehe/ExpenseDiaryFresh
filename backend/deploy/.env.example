# Copy to .env (same directory) and fill in before `docker compose up`.

# Your API domain, e.g. api.expensediary.co.za — must have a DNS A record
# pointing at this server's public IP before first start (Caddy needs it
# to issue the HTTPS certificate).
DOMAIN=api.example.co.za

# Postgres superuser password (any long random string; only used inside
# the Docker network).
POSTGRES_PASSWORD=replace-me-long-random

# JWT signing secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-different

# Email (Resend) for OTP password-reset codes. Without a real key, codes
# are only printed to the api container's logs.
RESEND_API_KEY=
RESEND_FROM=Expense Diary <onboarding@resend.dev>

# Mobile apps send no Origin header, so * is fine. Tighten if you ship a web build.
CORS_ORIGIN=*
